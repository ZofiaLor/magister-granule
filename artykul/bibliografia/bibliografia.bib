@InProceedings{id:Isaka1992inputspaceclustering,
  author    = {S. Isaka},
  title     = {On input space clustering by fuzzy systems and neural networks},
  booktitle = {IEEE International Conference on Systems, Man and Cybernetics, 1992},
  year      = {1992},
