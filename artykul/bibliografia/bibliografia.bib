@Article{id:Yager1993unifiedstructureand,
  author    = {R. R. Yager and D. P. Filev},
  title     = {Unified structure and parameter identification of fuzzy models},
  journal   = {Systems, Man and Cybernetics, IEEE Transactions on},
  year      = {1993},
  volume    = {23},
  number    = {4},
  pages     = {1198-1205},
  month     = {Jul/Aug},
  issn      = {0018-9472},
  abstract  = {The unified approach to fuzzy modeling developed in this correspondence addresses the problems of structure and parameter identification of fuzzy models. It demonstrates an alternative view to structure identification, transforming the problem of structure identification to estimation of the distribution of input space. A new concept of sample probability distributions (SPD) is introduced and a family of SPD is constructed. This allows us to simplify the problem of structure identification by replacing identification of membership functions of input variables with identification of the centers of cluster-like regions. The fuzzy model complex of fuzzy model is also discussed in connection with the modeller's confidence and two types of confidence-a priori and a posteriori confidence-are also suggested. The identification problem is solved also under the additional requirement of simplification of the model structure. A learning algorithm realizing structure and parameter identification of quasilinear fuzzy models with the simplest structure is proposed},
  doi       = {10.1109/21.247902},
  keywords  = {fuzzy logic; fuzzy set theory; inference mechanisms; learning (artificial intelligence); modelling; parameter estimation; pattern recognitiona posteriori confidence; a priori confidence; cluster-like regions; fuzzy models; learning algorithm; membership functions; modeller's confidence; parameter identification; sample probability distributions; structure identification; unified approach},
  timestamp = {2009.02.10},
}

