@Article{id:AjaFernandez2004hierarchicalfuzzysystems,
  author    = {S. Aja-Fernandez and C. Alberola-Lopez},
  title     = {Hierarchical fuzzy systems with {FITM}},
  journal   = {{IEEE} International Conference on Fuzzy Systems, 2004.},
  year      = {2004},
  volume    = {2},
  pages     = {767-772},
  month     = {July},
  issn      = {1098-7584},
  abstract  = {A matrix inference method for fuzzy systems (FITM) is used to deal with hierarchical fuzzy systems (HFSs). The contribution of this paper is twofold: on one hand, we show that a HFS (either serial or parallel) can be easily converted into a single fuzzy system, and implemented via FITM. On the other, we show that a serial HFS can be obtained out of a complicated multiple-input single-output fuzzy system. An example of such a conversion for a three-input system is included.},
  doi       = {10.1109/FUZZY.2004.1375497},
  keywords  = {fuzzy reasoning; fuzzy systems; hierarchical systems; matrix algebra fast inference using transition matrices; hierarchical fuzzy systems; matrix inference method; multiple input single output fuzzy system},
  timestamp = {2008.10.02},
}

@Article{id:Alcala2005geneticruleweighting,
  author   = {Rafael Alcalá and Jorge Casillas and Oscar Cordón and Antonio González and Francisco Herrera},
  title    = {A genetic rule weighting and selection process for fuzzy control of heating, ventilating and air conditioning systems},
  journal  = {Engineering Applications of Artificial Intelligence},
  year     = {2005},
  volume   = {18},
  number   = {3},
  pages    = {279-296},
  issn     = {0952-1976},
  abstract = {In this paper, we propose the use of weighted linguistic fuzzy rules in combination with a rule selection process to develop accurate fuzzy logic controllers dedicated to the intelligent control of heating, ventilating and air conditioning systems concerning energy performance and indoor comfort requirements. To do so, a genetic optimization process considering an efficient approach to perform rule weight derivation and rule selection is developed. This allows the tuning of the system to be developed at the rule level. The proposed technique was tested considering a physical modelization of a real test site.},
  doi      = {10.1016/j.engappai.2004.09.007},
  keywords = {Genetic algorithms},
}

