@Article{id:Liu2008Efficient,
  author   = {Feilong Liu},
  title    = {An efficient centroid type-reduction strategy for general type-2 fuzzy logic system},
  journal  = {Information Sciences},
  year     = {2008},
  volume   = {178},
  number   = {9},
  pages    = {2224-2236},
  issn     = {0020-0255},
  abstract = {In this paper, an efficient centroid type-reduction strategy for general type-2 fuzzy set is introduced. This strategy makes use of the result of \ensuremath{\alpha}-plane representation, and performs the centroid type-reduction on each \ensuremath{\alpha}-plane. Simulations show that it usually needs only several resolution of \ensuremath{\alpha} value such that the defuzzified value converges to a real value. Consequently, comparing with the exhaustive computation approach, this approach can tremendously decrease the computation complexity from exponential into linear.},
