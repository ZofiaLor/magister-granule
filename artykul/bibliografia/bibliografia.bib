@InProceedings{id:Filev1998Inversion,
  author    = {Dimitar P. Filev},
  title     = {Inversion of fuzzy models-practical issues},
  booktitle = {Fuzzy Systems Proceedings, 1998. IEEE World Congress on Computational Intelligence., The 1998 IEEE International Conference on},
  year      = {1998},
  volume    = {2},
  pages     = {1658-1663},
  month     = {May},
  abstract  = {This paper deals with some practical issues of the inversion of nonlinear static systems described by fuzzy models. We derive an analytical expression of the derivatives of a fuzzy mapping and we use it in an optimization based inversion algorithm. We discuss some practical aspects of this algorithm, including the inversion of multiple-input, multiple-output (MIMO) fuzzy systems. We also demonstrate how this approach can be used for calculation of the simultaneous solution that follows from two alternative fuzzy models},
