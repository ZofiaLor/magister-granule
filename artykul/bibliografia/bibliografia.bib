  title    = {A Fuzzy Inverse Model Construction Method for General Monotonic Multi-Input-Single-Output ({MISO}) Systems},
  journal  = {Fuzzy Systems, IEEE Transactions on},
  year     = {2008},
  volume   = {16},
  number   = {5},
  pages    = {1216-1231},
  month    = {Oct},
  issn     = {1063-6706},
  abstract = {This paper presents a novel method of systematically constructing a fuzzy inverse model for general multi-input-single-output (MISO) systems represented with triangular input membership functions, singleton output membership function, and fuzzy-mean defuzzification. The fuzzy inverse model construction method has the ability of uniquely determining the inverse relationship for each input-output pair. It is derived in a straightforward way and the required input variables can be simultaneously obtained by the fuzzy inferencing calculation to realize the desired output value. Simulation examples are provided to demonstrate the effectiveness of the proposed method to find the inverse kinematics solutions for complex multiple degree-of-freedom industrial robot manipulators.},
  doi      = {10.1109/TFUZZ.2008.924336},
  keywords = {control system synthesis; fuzzy control; industrial manipulators; manipulator kinematics; multivariable control systems; fuzzy inverse model construction method; fuzzy-mean defuzzification; general monotonic multiinput-single-output systems; inverse kinematics solutions; multiple degree-of-freedom industrial robot manipulators; singleton output membership function; triangular input membership functions; Fuzzy systems; fuzzy systems; inverse problems; multivariable systems; robot manipulators},
}

